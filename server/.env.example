# Copy this file to ".env" in the same folder and fill in your real values.
# Never commit the real ".env" file anywhere public.

# Get this from https://console.anthropic.com (Anthropic API key, starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Which Claude model to chat with. claude-sonnet-5 is a good default.
CLAUDE_MODEL=claude-sonnet-5

# Gmail address to send FROM (the account that emails you when someone wants to connect)
GMAIL_USER=youraddress@gmail.com

# A Gmail "App Password" (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords
# (You need 2-Step Verification turned on for your Google account first.)
GMAIL_APP_PASSWORD=your-16-char-app-password

# The email address that should RECEIVE the "someone wants to contact you" alerts.
NOTIFY_EMAIL=youraddress@gmail.com

# A passcode you make up, used to protect the /admin logs page so strangers can't read your chat logs.
ADMIN_PASSCODE=choose-a-private-passcode

# Port the server runs on
PORT=8787
